  "components": {
    "schemas": {
      "ClaimInput": {
        "properties": {
          "worker_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Worker Id"
          },
          "channel": {
            "type": "string",
            "title": "Channel",
            "default": "business"
          },
          "lease_seconds": {
            "type": "number",
            "maximum": 3600.0,
            "exclusiveMinimum": 0.0,
            "title": "Lease Seconds",
            "default": 30
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "worker_id"
        ],
        "title": "ClaimInput"
      },
      "CompleteInput": {
        "properties": {
          "worker_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Worker Id"
          },
          "epoch": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Epoch"
          },
          "output": {
            "additionalProperties": true,
            "type": "object",
            "title": "Output"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "worker_id",
          "epoch",
          "output"
        ],
        "title": "CompleteInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RunInput": {
        "properties": {
          "acceptance": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Acceptance"
          },
          "cost_limit_microusd": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cost Limit Microusd",
            "default": 1000000
          },
          "token_limit": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Token Limit",
            "default": 10000
          },
          "ruleset": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Ruleset",
            "default": "kernel-v1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "acceptance"
        ],
        "title": "RunInput"
      },
      "TaskInput": {
        "properties": {
          "task_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Task Id"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title"
          },
          "depends_on": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Depends On"
          },
          "priority": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": -1000.0,
            "title": "Priority",
            "default": 0
          },
          "channel": {
            "type": "string",
            "title": "Channel",
            "default": "business"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id",
          "title"
        ],
        "title": "TaskInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
