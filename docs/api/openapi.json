  "components": {
    "schemas": {
      "AgentRole": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "analyst",
              "architect",
              "tester",
              "developer",
              "reviewer",
              "fixer",
              "validator"
            ],
            "title": "Id"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Skills"
          },
          "tools": {
            "items": {
              "type": "string",
              "enum": [
                "workspace.read",
                "workspace.write",
                "tests.run",
                "artifacts.read",
                "artifacts.write"
              ]
            },
            "type": "array",
            "maxItems": 8,
            "title": "Tools"
          },
          "model_alias": {
            "type": "string",
            "maxLength": 48,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "title": "Model Alias"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "skills",
          "tools",
          "model_alias"
        ],
        "title": "AgentRole"
      },
      "ClaimInput": {
        "properties": {
          "worker_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Worker Id"
          },
          "channel": {
            "type": "string",
            "title": "Channel",
            "default": "business"
          },
          "lease_seconds": {
            "type": "number",
            "maximum": 3600.0,
            "exclusiveMinimum": 0.0,
            "title": "Lease Seconds",
            "default": 30
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "worker_id"
        ],
        "title": "ClaimInput"
      },
      "CompleteInput": {
        "properties": {
          "worker_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Worker Id"
          },
          "epoch": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Epoch"
          },
          "output": {
            "additionalProperties": true,
            "type": "object",
            "title": "Output"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "worker_id",
          "epoch",
          "output"
        ],
        "title": "CompleteInput"
      },
      "GoalInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 32000,
            "minLength": 1,
            "title": "Description"
          },
          "acceptance": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Acceptance"
          },
          "cost_limit_microusd": {
            "type": "integer",
            "maximum": 1000000000000.0,
            "minimum": 0.0,
            "title": "Cost Limit Microusd",
            "default": 1000000
          },
          "token_limit": {
            "type": "integer",
            "maximum": 1000000000.0,
            "minimum": 0.0,
            "title": "Token Limit",
            "default": 10000
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "description",
          "acceptance"
        ],
        "title": "GoalInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PlanApprovalInput": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "expected_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Expected Digest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "expected_digest"
        ],
        "title": "PlanApprovalInput"
      },
      "PlanInput": {
        "properties": {
          "definition": {
            "$ref": "#/components/schemas/WorkflowDefinition"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "definition",
          "expected_revision"
        ],
        "title": "PlanInput"
      },
      "RunInput": {
        "properties": {
          "acceptance": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Acceptance"
          },
          "cost_limit_microusd": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cost Limit Microusd",
            "default": 1000000
          },
          "token_limit": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Token Limit",
            "default": 10000
          },
          "ruleset": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Ruleset",
            "default": "kernel-v1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "acceptance"
        ],
        "title": "RunInput"
      },
      "TaskInput": {
        "properties": {
          "task_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Task Id"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title"
          },
          "depends_on": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Depends On"
          },
          "priority": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": -1000.0,
            "title": "Priority",
            "default": 0
          },
          "channel": {
            "type": "string",
            "title": "Channel",
            "default": "business"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id",
          "title"
        ],
        "title": "TaskInput"
      },
      "TaskLimits": {
        "properties": {
          "cost_limit_microusd": {
            "type": "integer",
            "maximum": 1000000000000.0,
            "minimum": 0.0,
            "title": "Cost Limit Microusd"
          },
          "token_limit": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 1.0,
            "title": "Token Limit"
          },
          "max_attempts": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Max Attempts",
            "default": 3
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cost_limit_microusd",
          "token_limit"
        ],
        "title": "TaskLimits"
      },
      "TaskNode": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 48,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title"
          },
          "instruction": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Instruction"
          },
          "role": {
            "type": "string",
            "enum": [
              "analyst",
              "architect",
              "tester",
              "developer",
              "reviewer",
              "fixer",
              "validator"
            ],
            "title": "Role"
          },
          "depends": {
            "items": {
              "type": "string",
              "maxLength": 48,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Depends"
          },
          "priority": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": -1000.0,
            "title": "Priority",
            "default": 0
          },
          "channel": {
            "type": "string",
            "enum": [
              "business",
              "verification"
            ],
            "title": "Channel",
            "default": "business"
          },
          "limits": {
            "$ref": "#/components/schemas/TaskLimits"
          },
          "evaluation_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluation Digest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "instruction",
          "role",
          "limits"
        ],
        "title": "TaskNode"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkflowDefinition": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "loom.workflow/v1",
            "title": "Schema Version"
          },
          "pack": {
            "type": "string",
            "const": "software-dev",
            "title": "Pack"
          },
          "scope": {
            "type": "string",
            "const": "local-workspace",
            "title": "Scope"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/AgentRole"
            },
            "type": "array",
            "maxItems": 7,
            "minItems": 7,
            "title": "Roles"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/TaskNode"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Nodes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "pack",
          "scope",
          "roles",
          "nodes"
        ],
        "title": "WorkflowDefinition"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
